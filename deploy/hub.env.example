# 線上端 (docker compose) 設定範例：複製為 .env.hub 後修改 (在專案根目錄執行：cp deploy/hub.env.example .env.hub)
# docker-compose.yml 的 app、postgres、caddy 都會讀取這個檔案。
# 已由 docker-compose.yml 固定、不需在此設定：REDIS_URL、AUTO_MIGRATE=0、TRUSTED_PROXY_COUNT=1、
#   SESSION_COOKIE_SECURE=1、SYNC_ROLE=hub、UPLOAD_FOLDER_MEMBER / UPLOAD_FOLDER_MENU、TZ=Asia/Taipei

# ---- 網域 (Caddy 會自動申請 HTTPS 憑證；DNS 的 A 記錄需先指向這台主機，且 80/443 埠要對外開放) ----
SITE_DOMAIN=kiosk.example.com

# ---- PostgreSQL (postgres 容器第一次啟動時以此建立資料庫與帳號) ----
POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
# 密碼請只用英數字 (例如 openssl rand -hex 24 產生)，避免在 DATABASE_URL 中需要跳脫
POSTGRES_PASSWORD=請改成強密碼
# 主機名稱固定為 postgres (compose 服務名稱)；帳號、密碼、資料庫名稱需與上面三項相同
DATABASE_URL=postgresql://kiosk:請改成強密碼@postgres:5432/kiosk

# ---- 安全性 (必填) ----
# Session 簽章金鑰：多個 worker 必須使用同一把，請產生一組隨機值 (例如 openssl rand -hex 32)；設定後不要再改
SECRET_KEY=

# ---- 預設店家負責人 (只在第一次建立帳號時使用) ----
# 未設定時會產生隨機帳密，只在第一次啟動時顯示在 docker compose logs app
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 忘記密碼時設為 1 並重啟 app 一次，把密碼重設為 ADMIN_PASSWORD；用完改回 0
RESET_ADMIN_PASSWORD_ON_START=0

# ---- gunicorn (選用；預設 2 個 worker × 128 執行緒，每條 SSE 長連線占 1 條執行緒，執行緒數請勿低於 100) ----
GUNICORN_WORKERS=2
GUNICORN_THREADS=128

# ---- 選用 ----
# Google Gemini (AI 文案與營運建議)；留空則改用規則引擎
GEMINI_API_KEY=
CSP_MODE=enforce

# ---- 同步 (線上端 SYNC_ROLE=hub 已由 docker-compose.yml 固定；分店權杖在後台「分店管理」產生) ----
# 分店超過幾秒沒有連線就暫停該分店的線上點餐
SYNC_NODE_OFFLINE_AFTER=120

# ---- 線上付款 (綠界；說明見 DEPLOY.txt 第五節) ----
# 預設使用綠界測試環境 (免註冊、不會扣款)。正式收款：ECPAY_STAGE=0 並填入正式特店資料
ONLINE_PAYMENT=1
ECPAY_STAGE=1
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 綠界通知付款結果的公開網址 (https://您的網域)
PUBLIC_BASE_URL=
PAYMENT_TIMEOUT_MINUTES=15
