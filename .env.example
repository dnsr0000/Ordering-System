# 複製為 .env 後依需要修改；所有設定都有預設值，本機門市通常只需要設定 ADMIN_USERNAME / ADMIN_PASSWORD

# ---- 預設店家負責人 (只在第一次建立帳號時使用；未設定則產生隨機帳密並在啟動時顯示一次) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 忘記密碼時設為 1 重啟一次，把密碼重設為 ADMIN_PASSWORD；用完改回 0
RESET_ADMIN_PASSWORD_ON_START=0

# ---- 資料庫 ----
# 留空 = 本機 SQLite (database/menu.db)；線上端填 PostgreSQL，例如 postgresql://kiosk:密碼@127.0.0.1/kiosk
DATABASE_URL=
# 啟動時自動升級資料庫；設 0 時請在啟動前執行 flask --app run setup (升級結構 + 建立預設店家與負責人)
AUTO_MIGRATE=1

# ---- 上傳檔 (留空 = 專案下的 uploads/member、uploads/menu) ----
UPLOAD_FOLDER_MEMBER=
UPLOAD_FOLDER_MENU=

# ---- 安全性 ----
# Session 簽章金鑰；留空則自動產生並存到 database/.secret_key
SECRET_KEY=
# 前面有幾層反向代理 (Nginx / Cloudflare 之後設 1；直接對外連線維持 0，否則來源 IP 可被偽造)
TRUSTED_PROXY_COUNT=0
# 全站 HTTPS 時設 1 (門市內網用 http://區網IP 存取時維持 0)
SESSION_COOKIE_SECURE=0
# 內容安全政策：enforce / report-only / off
CSP_MODE=enforce
# IP 頻率限制 (測試或壓測時可設 0)
RATELIMIT_ENABLED=1

# ---- 線上同步 (說明見 SYNC.txt、DEPLOY.txt 第三節) ----
# standalone：單機 (預設，不同步)；node：門市分店 (連到線上端)；hub：線上端 (通常用 Docker 部署)
SYNC_ROLE=standalone
# 分店：線上端網址 (必須 https) 與後台「分店管理」產生的權杖
SYNC_HUB_URL=
SYNC_NODE_TOKEN=
# 分店：同步間隔秒數、等待線上新訂單的長輪詢秒數
SYNC_INTERVAL=10
SYNC_LONG_POLL=20
# 分店：要同步的本機店家代號 (通常不用改)；0 = 伺服器啟動時不自動同步 (改用 flask --app run sync now)
SYNC_TENANT_SLUG=default
SYNC_AUTOSTART=1

# ---- 伺服器 (serve_windows.py / run.py) ----
HOST=0.0.0.0
PORT=5000

# ---- 在自己電腦練習線上付款 (正式線上端請用 deploy/hub.env.example) ----
# 需同時設定 SYNC_ROLE=hub；綠界通知需要公開網址，請用 ngrok 等工具並填入 PUBLIC_BASE_URL。
# 只想驗證付款流程時，直接執行 python scripts/payment_test.py 即可，不需改 .env。
# ONLINE_PAYMENT=1
# ECPAY_STAGE=1
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# ---- 選用 ----
# Webhook 送到內網 / http 網址 (只限自架內網整合；預設只允許 https 公開網址)
# WEBHOOK_ALLOW_PRIVATE=0
# WEBHOOK_ALLOW_HTTP=0
# 線上端多行程部署時用於頻率限制計數與即時通知 (SSE) 跨行程同步；本機單一行程不需要
REDIS_URL=
# Google Gemini (AI 文案與營運建議)；留空則改用本地模型或規則引擎
GEMINI_API_KEY=
# Waitress 執行緒數 (每條 SSE 長連線占用 1 條，請勿低於 100)
WAITRESS_THREADS=128
